{
  "name": "rover-engineer",
  "description": "Rover Engineer, a browser rover game for NASA Space Apps 2026. Code written with AI assistance (Anthropic Claude via Claude Code); see space-mission-design-game/submission/ai-disclosure.md.",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cinematic:dev": "CINEMATIC_PORT=5410 vite --config cinematic/vite.config.mjs",
    "cinematic:check": "tsc --noEmit -p cinematic/tsconfig.json",
    "cinematic:render": "node cinematic/tools/render.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "fast-png": "^8.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
